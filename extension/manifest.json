{
  "manifest_version": 3,
  "name": "YT Niche Collector",
  "version": "1.0",
  "description": "Collect YouTube URLs and save them to local server.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Niche Collector"
  }
}